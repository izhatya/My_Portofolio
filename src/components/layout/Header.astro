---
import Navigation from "./Navigation.astro";
import ThemeIcon from "../ui/ThemeIcon.astro";
import Social from "../ui/Social.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const [staticData] = await getCollection("staticData");
const { github, githubIconName, linkedin, linkedinIconName } = staticData.data;

// Menu hanya Home dan About Me
const navItems = ["home", "about"];
---

<header
  role="banner"
  aria-label="Main navigation"
  class="sticky top-0 z-50 w-full p-4 font-medium text-blacktext dark:text-zinc-300 dark:bg-[#0E0E11]/80 dark:border-b dark:border-zinc-800 bg-white/90 backdrop-blur-xs dark:backdrop-blur-xs max-md:z-50 max-md:px-0 transition-all"
>
  <div
    class="relative mx-auto flex max-w-7xl flex-row items-center justify-between max-xl:px-6"
  >
    <!-- LOGO DIHAPUS -->

    <!-- Navigasi Desktop (muncul di layar lebar) -->
    <Navigation items={navItems} />

    <!-- Ikon sosial & toggle -->
    <div class="flex items-center justify-between gap-5 text-xl">
      <div
        class="max-md:hidden flex items-center justify-center gap-5"
        role="group"
      >
        <Social link={github} iconName={githubIconName} />
        <Social link={linkedin} iconName={linkedinIconName} />
      </div>
    </div>
    <div class="flex items-center gap-5 text-xl md:pl-5">
      <ThemeIcon />
      <button
        class="hamburger md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="bars" class="hamburger-icon bars-icon" aria-hidden="true" />
        <Icon
          name="xmark"
          class="hamburger-icon xmark-icon"
          aria-hidden="true"
        />
      </button>
    </div>
  </div>

  <!-- MOBILE MENU (muncul saat hamburger diklik) -->
  <div class="mobile-menu hidden md:hidden" id="mobile-menu">
    <Navigation items={navItems} />
  </div>
</header>

<style>
  /* Sembunyikan ikon X secara default */
  .hamburger .xmark-icon {
    display: none;
  }
  /* Saat tombol aktif, sembunyikan ikon bars, tampilkan ikon X */
  .hamburger.active .bars-icon {
    display: none;
  }
  .hamburger.active .xmark-icon {
    display: block;
  }

  /* Mobile menu: default hidden, muncul saat .open */
  .mobile-menu {
    display: none;
    padding: 1rem;
    background: inherit;
  }
  .mobile-menu.open {
    display: block;
  }

  /* Atur ulang navigasi di mobile agar vertikal */
  @media (max-width: 767px) {
    .mobile-menu .nav-links {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 0.5rem 0;
    }
    .mobile-menu .nav-links a {
      width: 100%;
      text-align: center;
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .mobile-menu .nav-links a:last-child {
      border-bottom: none;
    }
    /* Tampilkan ikon sosial di mobile menu */
    .mobile-menu .social-container {
      display: flex !important;
      justify-content: center;
      gap: 1.5rem;
      margin-top: 1rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const hamburger = document.querySelector(".hamburger");
    const mobileMenu = document.querySelector(".mobile-menu");

    if (hamburger && mobileMenu) {
      hamburger.addEventListener("click", function(e) {
        e.stopPropagation();
        // Toggle class active pada hamburger (untuk ganti ikon)
        this.classList.toggle("active");
        // Toggle class open pada mobile menu
        mobileMenu.classList.toggle("open");

        // Update aria-expanded
        const isOpen = mobileMenu.classList.contains("open");
        this.setAttribute("aria-expanded", isOpen ? "true" : "false");
      });

      // Tutup menu saat klik di luar (opsional)
      document.addEventListener("click", function(e) {
        if (!hamburger.contains(e.target) && !mobileMenu.contains(e.target)) {
          hamburger.classList.remove("active");
          mobileMenu.classList.remove("open");
          hamburger.setAttribute("aria-expanded", "false");
        }
      });
    }
  });
</script>
