---
import Social from "../ui/Social.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const [staticData] = await getCollection("staticData");
const {
  github,
  githubIconName,
  linkedin,
  linkedinIconName,
  email,
  emailIconName,
  instagram,
  instagramIconName,
  youtube,
  youtubeIconName,
} = staticData.data;
---

<footer class="relative bottom-0 w-full px-4 py-8 font-medium text-blacktext dark:bg-transparent dark:border-b-2 dark:border-zinc-800 dark:text-zinc-300 max-lg:mt-3" role="contentinfo" aria-label="Site footer">
  <nav class="mx-auto flex max-w-7xl flex-row items-center justify-center gap-4 text-xl max-xl:px-6 max-sm:flex-col" aria-label="Footer navigation">
    
    <!-- HANYA IKON SOSIAL MEDIA (DI TENGAH) -->
    <div class="flex items-center justify-center gap-5" role="group" aria-label="Social media links">
      <a class="hover:text-mint-300 hover:scale-150 transition-all" target="_blank" href={email} rel="noopener noreferrer" aria-label="Send email">
        <Icon name={emailIconName} />
      </a>
      <a class="hover:text-mint-300 hover:scale-150 transition-all" target="_blank" href={instagram} rel="noopener noreferrer" aria-label="Visit Instagram">
        <Icon name={instagramIconName} />
      </a>
      <a class="hover:text-mint-300 hover:scale-150 transition-all" target="_blank" href={youtube} rel="noopener noreferrer" aria-label="Visit YouTube">
        <Icon name={youtubeIconName} />
      </a>
      <a class="hover:text-mint-300 hover:scale-150 transition-all" target="_blank" href={github} rel="noopener noreferrer" aria-label="Visit GitHub">
        <Icon name={githubIconName} />
      </a>
      <a class="hover:text-mint-300 hover:scale-150 transition-all" target="_blank" href={linkedin} rel="noopener noreferrer" aria-label="Visit LinkedIn">
        <Icon name={linkedinIconName} />
      </a>
    </div>
  </nav>
</footer>
