---
const { title } = Astro.props;
---

<div class="max-xl:hidden sticky top-24 w-72 h-fit">
  <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-neutral-100 dark:border-zinc-800 shadow-sm p-6">
    <h3 class="text-sm font-bold uppercase tracking-wide text-black/60 dark:text-zinc-400 mb-4">
      Table of Contents
    </h3>
    <nav class="space-y-1">
      <a href="#ringkasan" class="block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1 border-l-2 border-transparent hover:border-mint-400 pl-3">
        Ringkasan
      </a>
      <a href="#pengalaman-kerja" class="block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1 border-l-2 border-transparent hover:border-mint-400 pl-3">
        Pengalaman Kerja
      </a>
      <a href="#sertifikasi--lisensi" class="block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1 border-l-2 border-transparent hover:border-mint-400 pl-3">
        Sertifikasi & Lisensi
      </a>
      <a href="#keahlian-teknis" class="block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1 border-l-2 border-transparent hover:border-mint-400 pl-3">
        Keahlian Teknis
      </a>
      <a href="#proyek" class="block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1 border-l-2 border-transparent hover:border-mint-400 pl-3">
        Proyek
      </a>
      <a href="#volunteering" class="block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1 border-l-2 border-transparent hover:border-mint-400 pl-3">
        Volunteering
      </a>
      <a href="#kontak" class="block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1 border-l-2 border-transparent hover:border-mint-400 pl-3">
        Kontak
      </a>
    </nav>
  </div>
</div>
