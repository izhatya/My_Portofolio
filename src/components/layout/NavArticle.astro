---
const { title } = Astro.props;
---

<!-- Sidebar Table of Contents - muncul di layar ≥ 1024px (desktop) -->
<div class="hidden lg:block w-72 flex-shrink-0">
  <div class="sticky top-24 bg-white dark:bg-zinc-900 rounded-2xl border border-neutral-200 dark:border-zinc-700 shadow-lg p-6">
    <h3 class="text-sm font-bold uppercase tracking-wider text-black/60 dark:text-zinc-400 mb-4 flex items-center gap-2">
      <span class="w-1 h-5 bg-mint-400 rounded-full"></span>
      Table of Contents
    </h3>
    <nav class="space-y-0.5" id="toc-nav">
      <a href="#ringkasan" class="toc-link block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1.5 pl-3 border-l-2 border-transparent hover:border-mint-400">
        Ringkasan
      </a>
      <a href="#pengalaman-kerja" class="toc-link block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1.5 pl-3 border-l-2 border-transparent hover:border-mint-400">
        Pengalaman Kerja
      </a>
      <a href="#sertifikasi--lisensi" class="toc-link block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1.5 pl-3 border-l-2 border-transparent hover:border-mint-400">
        Sertifikasi &amp; Lisensi
      </a>
      <a href="#keahlian-teknis" class="toc-link block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1.5 pl-3 border-l-2 border-transparent hover:border-mint-400">
        Keahlian Teknis
      </a>
      <a href="#proyek" class="toc-link block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1.5 pl-3 border-l-2 border-transparent hover:border-mint-400">
        Proyek
      </a>
      <a href="#volunteering" class="toc-link block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1.5 pl-3 border-l-2 border-transparent hover:border-mint-400">
        Volunteering
      </a>
      <a href="#kontak" class="toc-link block text-sm text-black/70 dark:text-zinc-300 hover:text-mint-500 dark:hover:text-mint-400 transition-colors py-1.5 pl-3 border-l-2 border-transparent hover:border-mint-400">
        Kontak
      </a>
    </nav>
  </div>
</div>

<style>
  /* Gaya aktif: border kiri hijau + teks hijau + bold */
  .toc-link.active {
    color: #6ce9b7 !important;
    border-left-color: #6ce9b7 !important;
    font-weight: 600 !important;
  }
  .dark .toc-link.active {
    color: #6ce9b7 !important;
    border-left-color: #6ce9b7 !important;
  }
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const links = document.querySelectorAll('.toc-link');
    const sections = [];
    const ids = ['ringkasan', 'pengalaman-kerja', 'sertifikasi--lisensi', 'keahlian-teknis', 'proyek', 'volunteering', 'kontak'];
    
    ids.forEach(id => {
      const el = document.getElementById(id);
      if (el) sections.push({ id, el });
    });

    function updateActiveLink() {
      let currentId = null;
      let minTop = Infinity;
      const offset = 120; // offset dari atas viewport

      for (let i = 0; i < sections.length; i++) {
        const rect = sections[i].el.getBoundingClientRect();
        const top = rect.top;
        // Cari section yang paling dekat dengan offset dari atas, tapi masih di atas/bawah offset
        if (top <= offset) {
          // Ambil yang posisi top-nya paling mendekati offset (nilai top terbesar di bawah offset)
          if (top > -200 && top < minTop) {
            minTop = top;
            currentId = sections[i].id;
          }
        }
      }

      // Jika tidak ada yang cocok, gunakan section pertama
      if (!currentId && sections.length > 0) {
        currentId = sections[0].id;
      }

      links.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + currentId) {
          link.classList.add('active');
        }
      });
    }

    // Jalankan pertama kali
    updateActiveLink();

    // Jalankan saat scroll
    window.addEventListener('scroll', updateActiveLink, { passive: true });

    // Jalankan saat resize
    window.addEventListener('resize', updateActiveLink, { passive: true });

    // Saat link di-klik, update active setelah scroll selesai
    links.forEach(link => {
      link.addEventListener('click', function(e) {
        setTimeout(updateActiveLink, 150);
      });
    });
  });
</script>
