---
const { title } = Astro.props;
---

<!-- Sidebar Table of Contents -->
<div class="hidden lg:block w-72 flex-shrink-0">
  <div class="sticky top-24 bg-white dark:bg-zinc-900 rounded-2xl border border-neutral-200 dark:border-zinc-700 shadow-lg p-6">
    <h3 class="text-sm font-bold uppercase tracking-wider text-black/60 dark:text-zinc-400 mb-4 flex items-center gap-2">
      <span class="w-1 h-5 bg-mint-400 rounded-full"></span>
      Table of Contents
    </h3>
    <nav class="space-y-0.5" id="toc-nav">
      <a href="#ringkasan" class="toc-link block text-sm text-black/70 dark:text-zinc-300 transition-colors py-1.5 pl-3 border-l-2 border-transparent">
        Ringkasan
      </a>
      <a href="#pengalaman-kerja" class="toc-link block text-sm text-black/70 dark:text-zinc-300 transition-colors py-1.5 pl-3 border-l-2 border-transparent">
        Pengalaman Kerja
      </a>
      <a href="#sertifikasi--lisensi" class="toc-link block text-sm text-black/70 dark:text-zinc-300 transition-colors py-1.5 pl-3 border-l-2 border-transparent">
        Sertifikasi &amp; Lisensi
      </a>
      <a href="#keahlian-teknis" class="toc-link block text-sm text-black/70 dark:text-zinc-300 transition-colors py-1.5 pl-3 border-l-2 border-transparent">
        Keahlian Teknis
      </a>
      <a href="#proyek" class="toc-link block text-sm text-black/70 dark:text-zinc-300 transition-colors py-1.5 pl-3 border-l-2 border-transparent">
        Proyek
      </a>
      <a href="#volunteering" class="toc-link block text-sm text-black/70 dark:text-zinc-300 transition-colors py-1.5 pl-3 border-l-2 border-transparent">
        Volunteering
      </a>
      <a href="#kontak" class="toc-link block text-sm text-black/70 dark:text-zinc-300 transition-colors py-1.5 pl-3 border-l-2 border-transparent">
        Kontak
      </a>
    </nav>
  </div>
</div>

<style>
  /* SEMUA link TOC tebal permanen (font-weight: 600) */
  .toc-link {
    font-weight: 600 !important; /* tebal semua */
    text-shadow: 0 0 8px rgba(96, 250, 155, 0.3), 0 0 20px rgba(96, 250, 155, 0.1);
    transition: text-shadow 0.2s ease, color 0.2s ease;
  }
  /* Dark mode: warna default */
  .dark .toc-link {
    color: rgb(212, 212, 216) !important; /* zinc-300 */
  }
  /* Light mode: warna default */
  .toc-link {
    color: rgba(0, 0, 0, 0.7) !important; /* black/70 */
  }
  /* Hover: hanya memperkuat glow, tidak mengubah warna */
  .toc-link:hover {
    text-shadow: 0 0 12px rgba(96, 250, 155, 0.6), 0 0 30px rgba(96, 250, 155, 0.3);
    color: inherit !important;
  }
  /* Aktif: tidak ada perubahan font-weight (tetap tebal), hanya warna hijau */
  .toc-link.active {
    color: #6ce9b7 !important;
    border-left-color: #6ce9b7 !important;
    font-weight: 600 !important; /* tetap tebal */
    text-shadow: 0 0 8px rgba(96, 250, 155, 0.3), 0 0 20px rgba(96, 250, 155, 0.1) !important;
  }
  .dark .toc-link.active {
    color: #6ce9b7 !important;
    border-left-color: #6ce9b7 !important;
  }
  html {
    scroll-behavior: smooth;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const links = document.querySelectorAll('.toc-link');
    const sections = [];
    const ids = ['ringkasan', 'pengalaman-kerja', 'sertifikasi--lisensi', 'keahlian-teknis', 'proyek', 'volunteering', 'kontak'];
    
    ids.forEach(id => {
      const el = document.getElementById(id);
      if (el) sections.push({ id, el });
    });

    function updateActiveLink(id) {
      links.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + id) {
          link.classList.add('active');
        }
      });
    }

    const observer = new IntersectionObserver((entries) => {
      let visibleId = null;
      for (const entry of entries) {
        if (entry.isIntersecting) {
          visibleId = entry.target.id;
          break;
        }
      }
      if (visibleId) {
        updateActiveLink(visibleId);
      }
    }, {
      rootMargin: '-20% 0px -30% 0px',
      threshold: 0
    });

    sections.forEach(({ el }) => {
      observer.observe(el);
    });

    links.forEach(link => {
      link.addEventListener('click', function(e) {
        const href = this.getAttribute('href');
        const id = href.replace('#', '');
        updateActiveLink(id);
      });
    });

    let ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        window.requestAnimationFrame(function() {
          let bestId = null;
          let bestTop = -Infinity;
          const offset = 150;
          sections.forEach(({ id, el }) => {
            const rect = el.getBoundingClientRect();
            if (rect.top <= offset && rect.top > bestTop) {
              bestTop = rect.top;
              bestId = id;
            }
          });
          if (bestId) {
            updateActiveLink(bestId);
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    let firstId = sections[0]?.id || 'ringkasan';
    for (const { id, el } of sections) {
      const rect = el.getBoundingClientRect();
      if (rect.top <= 200) {
        firstId = id;
        break;
      }
    }
    updateActiveLink(firstId);
  });
</script>
