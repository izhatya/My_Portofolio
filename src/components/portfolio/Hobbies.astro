---
const hobbies = [
  "🔍 Cybersecurity Research",
  "📊 Network Monitoring",
  "📚 Membaca Buku Teknologi",
  "🏕️ Camping & Alam",
  "☕ Kopi & Diskusi",
  "💻 Eksplorasi Teknologi Baru",
];
---

<div class="flex flex-wrap gap-2">
  {
    hobbies.map((hobby) => (
      <div class="rounded-full bg-riptide-100 dark:bg-riptide-950/30 px-4 py-2 text-sm font-medium text-blacktext dark:text-zinc-300 border border-riptide-200 dark:border-riptide-800">
        {hobby}
      </div>
    ))
  }
</div>
