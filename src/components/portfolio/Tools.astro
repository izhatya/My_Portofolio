---
const tools = [
  "Fortinet (FortiGate, NSE 1-3)",
  "SonicWALL Firewall",
  "ESET Endpoint Security",
  "Safetica",
  "Genians NAC",
  "TCP/IP & Network Protocols",
  "Linux & Windows Server",
  "Vulnerability Assessment",
  "NOC Operations",
  "Log Analysis",
  "IDS/IPS",
  "Network Monitoring",
];
---

<div class="flex flex-wrap gap-2">
  {
    tools.map((tool) => (
      <div class="rounded-full bg-mint-100 dark:bg-mint-950/50 px-4 py-2 text-sm font-medium text-blacktext dark:text-zinc-300 border border-mint-200 dark:border-mint-800">
        {tool}
      </div>
    ))
  }
</div>
