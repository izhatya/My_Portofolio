---
import { Icon } from "astro-icon/components";
import Heading from "../ui/Heading.astro";

const projects = [
  {
    title: "Fortigate Installation & Configuration Training Bank Boyolali",
    description: "Instalasi dan konfigurasi Fortigate untuk keamanan jaringan Bank Boyolali. Deployment firewall, policy configuration, dan training tim IT internal.",
    skills: ["Fortinet", "Network Security", "Firewall Configuration"],
  },
  {
    title: "Training ESET Business RS Ortopedi Dr. Soeharso Surakarta",
    description: "Pelatihan dan implementasi ESET Business untuk Rumah Sakit Ortopedi Dr. Soeharso Surakarta. Deployment endpoint protection dan training penggunaan.",
    skills: ["ESET", "Network Security", "Endpoint Protection"],
  },
  {
    title: "POC Genians NAC RSUD Dr. Moewardi Surakarta",
    description: "Proof of Concept Network Access Control (NAC) Genians di RSUD Dr. Moewardi Surakarta. Menguji efektivitas NAC dalam mengontrol akses jaringan.",
    skills: ["Network Security", "NAC", "Genians"],
  },
];
---

<section class="py-8 px-8 max-md:py-4 scroll-m-16" id="projects">
  <div class="flex flex-col gap-8 max-w-5xl mx-auto">
    <div class="flex gap-4 items-center">
      <Icon class="text-3xl text-mint-500" name="code" />
      <Heading text="Projects" level={2} />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        projects.map((project) => (
          <div class="rounded-2xl border border-mint-200 dark:border-mint-800 bg-white dark:bg-zinc-900 p-6 shadow-md hover:shadow-xl transition-all duration-300">
            <h3 class="text-lg font-bold text-black dark:text-white mb-2">{project.title}</h3>
            <p class="text-sm text-black/70 dark:text-gray-300 mb-3">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {
                project.skills.map((skill) => (
                  <span class="text-xs bg-mint-100 dark:bg-mint-950/50 px-2 py-1 rounded-full text-black dark:text-gray-200 border border-mint-200 dark:border-mint-800">
                    {skill}
                  </span>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
