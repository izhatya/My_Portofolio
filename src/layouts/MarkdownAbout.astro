---
import { getCollection } from "astro:content";
import Layout from "./Layout.astro";

const [staticData] = await getCollection("staticData");
const {
  profileName,
  profileTitle,
  profileImage,
  profileAlt,
  profileLink,
} = staticData.data;

// Path gambar hardcode agar pasti muncul
const fullImage = "/My_Portofolio/images/profile.jpg";
---

<Layout pageTitle="Izhatya Widad Audifa - Network Security Engineer" description="Portofolio profesional Izhatya Widad Audifa">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Header Profil -->
    <div class="flex items-center gap-6 mb-8 max-sm:flex-col">
      <div class="w-32 h-32 rounded-full overflow-hidden flex-shrink-0">
        <img src={fullImage} alt={profileAlt} class="w-full h-full object-cover" />
      </div>
      <div>
        <h1 class="text-3xl font-bold dark:text-white">{profileName}</h1>
        <p class="text-lg text-mint-600 dark:text-mint-400">{profileTitle}</p>
        <a href={profileLink} class="text-sm text-mint-500 hover:underline">View full profile →</a>
      </div>
    </div>

    <!-- Konten Markdown (dari about-me.md) -->
    <article class="prose dark:prose-invert max-w-none prose-headings:text-black dark:prose-headings:text-white prose-a:text-mint-500">
      <slot />
    </article>
  </div>
</Layout>
