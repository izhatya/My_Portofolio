---
import { getCollection } from "astro:content";
import Layout from "./Layout.astro";

const [staticData] = await getCollection("staticData");
const {
  profileName,
  profileTitle,
  profileImage,
  profileAlt,
  profileLink,
} = staticData.data;

const fullImage = "/My_Portofolio/images/profile.jpg";
---

<Layout 
  pageTitle="Izhatya Widad Audifa - Network Security Engineer" 
  description="Portofolio profesional Izhatya Widad Audifa, Network Security Engineer"
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    
    <!-- HEADER PROFIL -->
    <div class="bg-white dark:bg-zinc-900 rounded-3xl shadow-xl border border-gray-200 dark:border-mint-800 p-8 mb-12">
      <div class="flex items-center gap-8 max-sm:flex-col max-sm:text-center">
        <div class="flex-shrink-0">
          <div class="w-32 h-32 rounded-full overflow-hidden border-4 border-mint-400 shadow-lg">
            <img src={fullImage} alt={profileAlt} class="w-full h-full object-cover" />
          </div>
        </div>
        <div>
          <h1 class="text-4xl font-black text-black dark:text-white max-sm:text-3xl">
            {profileName} 👋
          </h1>
          <p class="text-xl font-semibold text-mint-600 dark:text-mint-400 max-sm:text-lg">
            {profileTitle}
          </p>
          <a 
            href={profileLink} 
            class="inline-flex items-center gap-2 mt-3 text-sm font-medium text-mint-500 hover:text-mint-600 transition-colors"
          >
            Lihat profil lengkap →
          </a>
        </div>
      </div>
    </div>

    <!-- KONTEN MARKDOWN - PUTIH TERANG -->
    <div class="bg-white dark:bg-zinc-900 rounded-3xl shadow-xl border border-gray-200 dark:border-mint-800 p-8">
      <article class="prose prose-lg max-w-none 
        prose-headings:text-black dark:prose-headings:text-white 
        prose-headings:font-bold prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl
        prose-a:text-mint-500 prose-a:no-underline hover:prose-a:underline
        prose-strong:text-black dark:prose-strong:text-white
        prose-ul:list-disc prose-li:marker:text-mint-400
        prose-blockquote:border-mint-400 prose-blockquote:bg-mint-50 dark:prose-blockquote:bg-mint-950/30
        prose-code:text-mint-600 dark:prose-code:text-mint-300
        prose-pre:bg-gray-100 dark:prose-pre:bg-zinc-800
        prose-table:border-collapse prose-table:border prose-table:border-gray-300 dark:prose-table:border-mint-800
        prose-th:bg-mint-100 dark:prose-th:bg-mint-950/50 prose-th:border prose-th:border-gray-300 dark:prose-th:border-mint-800
        prose-td:border prose-td:border-gray-300 dark:prose-td:border-mint-800 prose-td:p-3
        prose-p:text-black dark:prose-p:text-gray-200
        prose-li:text-black dark:prose-li:text-gray-200
        prose-hr:border-gray-300 dark:prose-hr:border-mint-800
      ">
        <slot />
      </article>
    </div>
  </div>
</Layout>
