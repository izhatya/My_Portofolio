---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en" class="dark:bg-[#0E0E11] bg-mint-50/5 font-montserrat scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{Astro.props.pageTitle || "My Portfolio"}</title>
    <meta name="description" content={Astro.props.description || ""} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/styles/global.css" />
    <slot name="head" />
  </head>
  <body>
    <div class="blur-circle"></div>
    <div style="background:linear-gradient(45deg, rgba(96, 250, 155, 0) 10.79%, rgba(96, 250, 170, 0.03) 40.92%, rgba(96, 250, 155, 0) 90.35%)" class="fixed top-0 left-0 w-full h-full pointer-events-none -z-1"></div>
    
    <Header />
    
    <main class="min-h-[80vh]">
      <slot />
    </main>
    
    <Footer />
  </body>
</html>
