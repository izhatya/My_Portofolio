---
import { Viewport } from "astro";
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en" class="dark:bg-[#0E0E11] bg-mint-50/5 font-montserrat scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{Astro.props.pageTitle || "My Portfolio"}</title>
    <meta name="description" content={Astro.props.description || ""} />
    <link rel="icon" href="/favicon.ico" />
    <!-- Tambahkan CSS global -->
    <link rel="stylesheet" href="/styles/global.css" />
    <slot name="head" />
  </head>
  <body>
    <!-- Header sederhana (tanpa Icon) -->
    <header class="sticky top-0 z-50 w-full p-4 bg-white/90 dark:bg-[#0E0E11]/80 backdrop-blur-sm border-b dark:border-zinc-800">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
        <a href="/" class="text-xl font-bold text-black dark:text-white">Home</a>
        <nav class="flex gap-4">
          <a href="/" class="text-black dark:text-white hover:text-mint-400">Home</a>
          <a href="/about-me" class="text-black dark:text-white hover:text-mint-400">About</a>
        </nav>
      </div>
    </header>

    <!-- Konten utama -->
    <main class="min-h-[80vh]">
      <slot />
    </main>

    <!-- Footer sederhana -->
    <footer class="text-center py-4 border-t dark:border-zinc-800">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        &copy; {new Date().getFullYear()} Izhatya Widad Audifa
      </p>
    </footer>
  </body>
</html>
